{
  "name":"nourbest-os-desktop",
  "version":"3.0.0",
  "description":"NourBest OS native desktop wrapper",
  "main":"main.js",
  "scripts":{"start":"electron .","dist":"electron-builder"},
  "devDependencies":{"electron":"37.2.0","electron-builder":"26.0.12"},
  "build":{
    "appId":"sa.nourbest.os",
    "productName":"NourBest OS",
    "files":["main.js","package.json"],
    "extraResources":[{"from":"../","to":"nourbest","filter":["index.html","styles.css","app.js","storage-db.js","plugin-api.js","sw.js","manifest.webmanifest","release.json","icons/**/*","plugins/**/*","vendor/**/*","screenshots/**/*"]}],
    "linux":{"target":["AppImage"],"icon":"../icons/nourbest-512.png"},
    "win":{"target":["nsis"],"icon":"../icons/nourbest-512.png"},
    "mac":{"target":["dmg"],"icon":"../icons/nourbest-512.png"}
  }
}
