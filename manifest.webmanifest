{
  "name": "NourBest OS",
  "short_name": "NourBest",
  "id": "./",
  "description": "مساحة عمل عربية هجينة، سريعة، خاصة وتعمل دون إنترنت.",
  "lang": "ar",
  "dir": "rtl",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#07111f",
  "theme_color": "#07111f",
  "categories": ["productivity", "utilities"],
  "prefer_related_applications": false,
  "launch_handler": {"client_mode":"navigate-existing"},
  "icons": [
    {"src":"icons/nourbest-192.png","sizes":"192x192","type":"image/png","purpose":"any maskable"},
    {"src":"icons/nourbest-512.png","sizes":"512x512","type":"image/png","purpose":"any maskable"}
  ],
  "screenshots": [
    {"src":"screenshots/desktop.png","sizes":"1280x720","type":"image/png","form_factor":"wide","label":"سطح مكتب NourBest OS"},
    {"src":"screenshots/mobile.png","sizes":"750x1334","type":"image/png","label":"NourBest OS على الجوال"}
  ],
  "shortcuts": [
    {"name":"الملفات","url":"./?app=files","icons":[{"src":"icons/nourbest-192.png","sizes":"192x192"}]},
    {"name":"الملاحظات","url":"./?app=notes","icons":[{"src":"icons/nourbest-192.png","sizes":"192x192"}]}
  ]
